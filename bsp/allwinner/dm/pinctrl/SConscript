from building import *
Import('RTT_ROOT')

cwd = GetCurrentDir()
src = []

if GetDepend(['RT_PINCTRL_SUN252I_F101']):
    src += ['pinctrl-sun252i-f101.c']

if GetDepend(['RT_PINCTRL_SUN50I_H616']):
    src += ['pinctrl-sun50i-h616.c']

if src:
    src += ['pinctrl-sunxi.c']

group = DefineGroup('DeviceDrivers', src, depend = [''],
        CPPPATH = [cwd + '/../include', RTT_ROOT + '/components/drivers/pin'])

Return('group')
