config RT_CLOCK_TIMER_SUNXI
    bool "Allwinner Sunxi timer and high-speed timer"
    depends on RT_USING_CLOCK_TIME
    depends on RT_USING_DM
    depends on RT_USING_CLK
    depends on RT_USING_RESET
    default n
    help
      Enable the F101's two 24 MHz timers and two high-speed timers as
      clock_time timer devices. The RISC-V CLINT remains the system timer.
