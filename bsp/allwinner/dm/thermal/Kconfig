config RT_THERMAL_SUNXI
    bool "Allwinner Sunxi thermal sensor"
    depends on RT_USING_CLK
    depends on RT_USING_NVMEM
    depends on RT_USING_RESET
    depends on RT_USING_THERMAL
    default n

config RT_THERMAL_SUN50I_H616
    bool "Allwinner H616 thermal sensors"
    depends on RT_USING_CLK && RT_USING_NVMEM && RT_USING_RESET
    depends on RT_USING_THERMAL
    select RT_NVMEM_SUNXI_SID
    select RT_USING_MFD
    select RT_MFD_SYSCON
    default n
