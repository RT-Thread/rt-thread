/*
 * External 360x360 ST77916-compatible panel on SPI1. The complete signal
 * wiring is shared by the original 1.8 inch module and the Truly JD9855 1.5
 * inch module; Kconfig selects their distinct initialization sequence.
 *
 *   F101 pin       Panel signal            SPI1/QSPI function
 *   ------------   ---------------------   -----------------
 *   GND            GND                     Common ground
 *   PD0            CS                      SPI1-CS0
 *   PD1            SCL/CLK                 SPI1-CLK
 *   PD2            SDA/SDI/D0              SPI1-MOSI/QSPI-D0
 *   PD3            SDO/D1                  SPI1-MISO/QSPI-D1
 *   PD5            D2/WP                   SPI1-QSPI-D2
 *   PD4            D3/HOLD                 SPI1-QSPI-D3
 *   PD6            RESET                   Active-low GPIO output
 *   PD7            TE                      Active-high GPIO input
 *
 * PD4 and PD5 are intentionally ordered D3 then D2 in the F101 pinmux; do
 * not interchange the two panel wires. Commands use D0 and pixel data uses
 * all four QSPI data lines, so the panel needs no separate D/C line. Supply
 * VCC and the panel backlight according to the display module/adapter
 * specification; this binding does not drive a backlight GPIO or PWM. All
 * connected GPIO signal levels must be compatible with the panel's 3.3 V IO.
 * PD0 through PD7 are dedicated to this panel while this overlay is enabled.
 */
&pio {
    spi1_pd_qspi_pins: spi1-pd-qspi-pins {
        pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5";
        function = "spi1";
    };
};

&spi1_ctrl {
    allwinner,qspi-mode;
    pinctrl-names = "default";
    pinctrl-0 = <&spi1_pd_qspi_pins>;
    status = "okay";

    display@0 {
        compatible = "sitronix,st77916";
        reg = <0>;
        /* Commands are initialized at 10 MHz; QSPI pixel transfers use 60 MHz. */
        spi-max-frequency = <60000000>;
        /* Match the panel's proven ESP QSPI transaction: opcode 0x32. */
        spi-tx-bus-width = <4>;
        spi-rx-bus-width = <4>;
        reset-gpios = <&pio 3 6 PIN_ACTIVE_LOW>;
        te-gpios = <&pio 3 7 PIN_ACTIVE_HIGH>;
        width = <360>;
        height = <360>;
#ifdef SBC_YUZUKINEKO_ST77916_JD9855
        /* RGB565 reduces full-frame QSPI traffic from 388800 to 259200 bytes. */
        format = "r5g6b5";

        /* command, post-command delay in ms, payload size, payload */
        panel-init-sequence = [
            de 00 01 00
            df 00 02 98 55
            ce 00 02 0d 00
            b2 00 01 30
            b7 00 04 01 35 01 5d
            bb 00 06 1b 64 e3 34 3e f3
            bc 00 04 00 18 f3 c0
            c0 00 02 22 c1
            c3 00 0b 00 02 2a 0b 08 47 08 04 62 30 30
            c4 00 0b 40 00 ad 68 43 07 04 16 43 07 04
            c8 00 20
                3f 2e 24 1f 20 21 1d 1d 1d 1c 19 0e 0b 07 03 02
                3f 2e 24 1f 20 21 1d 1d 1d 1c 19 0e 0b 07 03 02
            d3 00 02 28 13
            d9 00 06 00 00 ff 00 f0 00
            de 00 01 01
            b7 00 08 13 e7 64 39 06 36 19 1c
            be 00 01 00
            c1 00 04 04 4a 90 08
            c2 00 04 00 16 da e7
            c4 00 02 72 12
            c7 00 06 00 00 09 3d 09 3d
            c8 00 06 00 00 0b 3d 16 39
            c9 00 05 00 0a 08 06 04
            ca 00 05 1e 1f 10 17 18
            cb 00 05 01 0b 09 07 05
            cc 00 05 1e 1f 11 17 18
            cd 00 05 31 25 27 29 2b
            ce 00 05 3f 3e 21 37 38
            cf 00 05 30 24 26 28 2a
            d0 00 05 3f 3e 20 37 38
            d1 00 05 06 30 a5 db 30
            d3 00 06 3b 08 00 00 00 00
            d4 00 06 67 00 00 01 00 01
            d5 00 07 10 10 07 07 0f 94 26
            d6 00 03 00 00 40
            d7 00 03 01 84 20
            de 00 01 02
