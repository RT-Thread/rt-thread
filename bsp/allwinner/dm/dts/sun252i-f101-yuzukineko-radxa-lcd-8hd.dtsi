        15 00 02 76 00
        15 00 02 77 d5
        15 00 02 78 2e
        15 00 02 79 12
        15 00 02 7a 03
        15 00 02 7b 00
        15 00 02 7c 00
        15 00 02 7d 03
        15 00 02 7e 7b
        15 00 02 e0 04
        15 00 02 00 0e
        15 00 02 02 b3
        15 00 02 09 60
        15 00 02 0e 2a
        15 00 02 36 59
        15 00 02 e0 00
        15 00 02 80 01
        15 00 02 e0 00
        05 78 01 11
        05 00 01 29
    ];
    panel-exit-sequence = [
        05 00 01 28
        05 64 01 10
    ];

    status = "okay";

    panel-timing {
        clock-frequency = <70857000>;
        hactive = <800>;
        hfront-porch = <40>;
        hback-porch = <20>;
        hsync-len = <20>;
        vactive = <1280>;
        vfront-porch = <30>;
        vback-porch = <28>;
        vsync-len = <4>;
    };
};

&i2c2_ctrl {
    clock-frequency = <400000>;

    touchscreen@14 {
        compatible = "goodix,gt911";
        reg = <0x14>;
        tp-supply = <&reg_vcc_3v3>;
        irq-gpios = <&pio 3 7 PIN_ACTIVE_HIGH>;
        reset-gpios = <&pio 3 8 PIN_ACTIVE_HIGH>;
        max-x = <800>;
        max-y = <1280>;
        status = "okay";
    };
};
