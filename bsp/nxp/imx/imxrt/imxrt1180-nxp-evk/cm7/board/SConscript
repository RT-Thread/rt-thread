Import('rtconfig')
Import('RTT_ROOT')

from building import *
import os

cwd = GetCurrentDir()

if GetDepend(['BSP_USING_OSPI_FLASH']):
    # add the OSPI_hyperFlash drivers.
    src = Split("""
    board.c
    MCUX_Config_hyperFlash/clock_config.c
    MCUX_Config_hyperFlash/pin_mux.c
    """)
else:
    # add the general drivers.
    src = Split("""
    board.c
    MCUX_Config/clock_config.c
    MCUX_Config/pin_mux.c
    """)

if GetDepend(['BSP_USING_QSPI_FLASH']):
    src += ['ports/drv_flexspi_nor_flash.c']

if GetDepend(['BSP_USING_QSPI_FLASH_FS']):
    src += ['ports/drv_flexspi_nor_flash.c', 'ports/fal_flash_port.c']

if GetDepend(['BSP_USING_OSPI_FLASH']):
    src += ['ports/flexspi_octal_flash_ops.c']

if GetDepend(['BSP_USING_OSPI_FLASH']):
    CPPPATH = [cwd,cwd + '/MCUX_Config_hyperFlash',cwd + '/ports']
else:
    CPPPATH = [cwd,cwd + '/MCUX_Config',cwd + '/ports']

CPPDEFINES = ['CPU_MIMXRT1189CVM8C_cm7', 'MIMXRT1189_cm7_SERIES', 'ARM_MATH_CM7']
LINKFLAGS = ''

if rtconfig.PLATFORM in ['gcc']:
    CPPDEFINES += ['__STARTUP_INITIALIZE_RAMFUNCTION']

if rtconfig.PLATFORM in ['armcc', 'armclang']:
    # CPPDEFINES += ['SDK_DEBUGCONSOLE']
    CPPDEFINES += ['NDEBUG']

if rtconfig.PLATFORM in ['iccarm']:
    CPPDEFINES += ['NDEBUG']

if GetDepend(['BSP_USE_HYPERRAM']):
    CPPDEFINES += ['USE_HYPERRAM=1']

if GetDepend(['BSP_USE_MULTICORE']):
    CPPDEFINES += ['__USE_SHMEM', 'MULTICORE_APP=1']
    CPPDEFINES += ['XIP_EXTERNAL_FLASH=1']
    if rtconfig.PLATFORM in ['gcc']:
        LINKFLAGS += ' -Wl,-defsym,__use_shmem__=1'
        LINKFLAGS += ' -Wl,-defsym,__multicore__=1'
    if rtconfig.PLATFORM in ['armcc', 'armclang']:
        LINKFLAGS += ' --predefine="-D__use_shmem__=1"'
        LINKFLAGS += ' --predefine="-D__multicore__=1"'
    if rtconfig.PLATFORM in ['iccarm']:
        LINKFLAGS += ' __use_shmem__=1'
        LINKFLAGS += ' __multicore__=1'

if GetDepend(['BSP_USING_ETH']):
    CPPDEFINES += ['SDK_NETC_USED=1', 'FSL_ETH_ENABLE_CACHE_CONTROL=1']

if GetDepend(['RT_USING_CHERRYUSB']):
    cherryusb_path = os.path.join(RTT_ROOT, 'components', 'drivers', 'usb', 'cherryusb')
    src += ['cherryusb_port.c']
    if GetDepend(['RT_CHERRYUSB_DEVICE_TEMPLATE_CDC_ACM']):
        src += ['cherryusb_cdc_acm.c']
    if GetDepend(['BSP_CHERRYUSB_HOST_MOUSE_DEMO']):
        src += ['usbh_mouse_demo.c']
    CPPPATH += [
        cherryusb_path,
        os.path.join(cherryusb_path, 'common'),
        os.path.join(cherryusb_path, 'core'),
        os.path.join(cherryusb_path, 'class', 'hub'),
        os.path.join(cherryusb_path, 'class', 'cdc'),
        os.path.join(cherryusb_path, 'class', 'hid'),
    ]

if GetDepend(['BSP_LINKER_SCRIPT_FLEXSPI_NOR']):
    CPPDEFINES += ['XIP_EXTERNAL_FLASH=1']

if GetDepend(['BSP_LINKER_SCRIPT_FLEXSPI_NOR_HYPERRAM']):
    CPPDEFINES += ['XIP_EXTERNAL_FLASH=1']    

group = DefineGroup('Drivers', src, depend = [''], CPPPATH = CPPPATH, CPPDEFINES=CPPDEFINES, LINKFLAGS=LINKFLAGS)

Return('group')
