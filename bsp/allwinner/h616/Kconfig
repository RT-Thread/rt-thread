mainmenu "RT-Thread H616 Configuration"

BSP_DIR := .
RTT_DIR := ../../..
PKGS_DIR := packages
SOC_DM_DIR := $(BSP_DIR)/../dm

source "$(SOC_DM_DIR)/Kconfig"
# H616 uses the generic ARM GIC and DesignWare UART drivers.
SOC_DM_PIC_DIR := $(RTT_DIR)/libcpu/aarch64/common/pic
SOC_DM_SERIAL_DIR := $(RTT_DIR)/libcpu/aarch64/common/serial

source "$(RTT_DIR)/Kconfig"
osource "$(PKGS_DIR)/Kconfig"

config SOC_H616
    bool
    default y
    select ARCH_ARMV8
    select ARCH_ARM_MMU
    select ARCH_CPU_64BIT
    select RT_USING_CACHE
    select RT_USING_COMPONENTS_INIT
    select RT_USING_USER_MAIN
    select RT_USING_STDC_ATOMIC
    help
        Boot through U-Boot and TF-A, using the device tree supplied in x0
        by U-Boot. Memory size and board wiring come from that device tree.
        No board DTB is built or embedded by this BSP.
