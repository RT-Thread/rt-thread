# libxt_hal.a supplies xthal_save/restore_extra_nw, xthal_window_spill_nw and
# the coprocessor save/restore used by libcpu/xtensa and xtensa_context.S.
LIB_PATH = [PKG + '/components/xtensa/esp32s3']
LIB = ['xt_hal']

CPPDEFINES = [
    'IDF_VER=\\"999\\"',
    'PROJECT_VER=\\"999\\"',
    '_GNU_SOURCE',
    'MULTI_HEAP_FREERTOS',
    'ESP_PLATFORM=1',
    'IDF_TARGET=esp32s3',
    '_POSIX_READER_WRITER_LOCKS',
    'PROJECT_NAME=\\"rtthread\\"',
    '__ets__',
    # The fork's spi_flash_defs.h predates the ESP32-S3 cache-wrap feature and
    # does not define CMD_WRAP, but the (newer) bootloader_flash.c uses it
    # under #if SOC_CACHE_SUPPORT_WRAP. Value per ESP-IDF v5.1.4's
    # spi_flash/spi_flash_defs.h:0x77. Harmless for C3-only files.
    'CMD_WRAP=0x77',
]

group = DefineGroup('esp-idf', src, depend = ['PKG_USING_ESP_IDF'],
                    CPPPATH = path, LIBS = LIB, LIBPATH = LIB_PATH,
                    CPPDEFINES = CPPDEFINES)

Return('group')
