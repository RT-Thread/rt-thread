/*
 * Radxa LCD 8HD with the Raspberry Pi 4B 15-pin to 40-pin accessory,
 * including its populated flex and auxiliary header. NOT the passive
 * ROCK 5B 39-pin cable. Use only one display adapter at a time.
 *
 * 15-pin host connector, Raspberry Pi 4B J4 numbering:
 * 1/4/7/10/13 GND; 2 PD15 D1N; 3 PD14 D1P;
 * 5 PD17 CKN; 6 PD16 CKP; 8 PD13 D0N; 9 PD12 D0P;
 * 11 PB2 SCL; 12 PB3 SDA; 14/15 VCC-3V3.
 *
 * Auxiliary accessory signals (identify by label, not assumed order):
 * VCC-5V -> H2-20 VBUS; GND -> H2-19;
 * BL-PWM and LCD-RESET -> H1-1 VCC-3V3, as in the Pi reference;
 * TP-RST -> PD8; TP-INT -> PD7; seventh signal unused.
 * No additional backlight converter, 1.8 V regulator or level shifter.
 * Power from the board USB only; verify the total supply budget.
 *
 * Commands and timing: Radxa panel-radxa-dsi-dkms 1.0.0 Pi driver.
 * The current Sunxi driver does not consume dsi,flags or the exit sequence.
 * Clock programming and DSI video-mode compatibility still need validation.
 */
&display0 {
    pinctrl-names = "default";
    pinctrl-0 = <&dsi0_pd_pins>;
    allwinner,output = "dsi";
    /* Divider 4 needs a 283.428 MHz parent for exactly 70.857 MHz. */
    allwinner,tcon-dclk-div = <4>;
    dsi,lanes = <2>;
    dsi,format = "rgb888";
    /* VIDEO | VIDEO_HSE | CLOCK_NON_CONTINUOUS; init commands use LP. */
    dsi,flags = <0x405>;

    /* DSI data type, post-command delay in ms, payload size, payload. */
    panel-init-sequence = [
        15 00 02 e0 00
        15 00 02 e1 93
        15 00 02 e2 65
        15 00 02 e3 f8
        15 00 02 80 03
        15 00 02 e0 01
        15 00 02 00 00
        15 00 02 01 72
        15 00 02 03 00
        15 00 02 04 65
        15 00 02 0c 74
        15 00 02 17 00
        15 00 02 18 b7
        15 00 02 19 00
        15 00 02 1a 00
        15 00 02 1b b7
        15 00 02 1c 00
        15 00 02 24 fe
        15 00 02 37 19
        15 00 02 38 05
        15 00 02 39 00
        15 00 02 3a 01
        15 00 02 3b 01
        15 00 02 3c 70
        15 00 02 3d ff
        15 00 02 3e ff
        15 00 02 3f ff
        15 00 02 40 06
        15 00 02 41 a0
        15 00 02 43 1e
        15 00 02 44 0f
        15 00 02 45 28
        15 00 02 4b 04
        15 00 02 55 02
        15 00 02 56 01
        15 00 02 57 a9
        15 00 02 58 0a
        15 00 02 59 0a
        15 00 02 5a 37
        15 00 02 5b 19
        15 00 02 5d 78
        15 00 02 5e 63
        15 00 02 5f 54
        15 00 02 60 48
        15 00 02 61 45
        15 00 02 62 38
        15 00 02 63 3d
        15 00 02 64 28
        15 00 02 65 43
