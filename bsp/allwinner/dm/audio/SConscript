from building import *

cwd = GetCurrentDir()
src = []
CPPPATH = [cwd + '/../include']

if GetDepend(['RT_AUDIO_SUNXI_CODEC']):
    src += ['audio-sunxi-codec.c']

if GetDepend('RT_AUDIO_SUNXI_I2S0') or GetDepend('RT_AUDIO_SUNXI_OWA'):
    src += ['audio-sunxi.c']

if GetDepend(['RT_AUDIO_SUNXI_I2S0']):
    src += ['audio-sunxi-i2s.c']

if GetDepend(['RT_AUDIO_SUNXI_OWA']):
    src += ['audio-sunxi-owa.c']

group = DefineGroup('DeviceDrivers', src, depend = [''], CPPPATH = CPPPATH)

Return('group')
