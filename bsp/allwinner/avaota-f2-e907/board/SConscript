from building import *
import os
import sys

Import('env')

cwd = GetCurrentDir()
src = Split('''
    board.c
    board_c907_release.c
    drv_rpmsg.c
    clint.c
    tick.c
    trap.c
    startup_gcc.S
''')

# board.dtb is generated by gen_board_dtb.py and embedded by builtin_fdt.S with
# .incbin, which scons cannot scan. Build the object here so that it can depend
# on the generated DTB: a clean tree generates the DTB before assembling, and
# editing the generator rebuilds both.
dtb = env.Command(os.path.join(cwd, 'board.dtb'),
                  os.path.join(cwd, 'gen_board_dtb.py'),
                  '"%s" $SOURCE' % sys.executable)
fdt_obj = env.Object(os.path.join(cwd, 'builtin_fdt.S'))
env.Depends(fdt_obj, dtb)

group = DefineGroup('Drivers', src, depend = [''], CPPPATH = [cwd])
group += fdt_obj

Return('group')
