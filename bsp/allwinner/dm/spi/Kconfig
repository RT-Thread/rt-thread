config RT_SPI_SUNXI
    bool "Allwinner Sunxi SPI controller"
    depends on RT_USING_SPI
    depends on RT_USING_DM
    depends on RT_USING_CLK
    depends on RT_USING_RESET
    default n

config RT_QSPI_SUNXI
    bool "Allwinner Sunxi QSPI controller mode"
    depends on RT_USING_QSPI
    select RT_SPI_SUNXI
    default n
