Import('rtconfig')
from building import *

cwd     = GetCurrentDir()
src     = []
CPPPATH = [cwd, cwd + '/../../include']

if GetDepend(['RT_UTEST_WDT']):
    src += ['wdt_tc.c']

group = DefineGroup('utestcases', src, depend = ['RT_USING_UTESTCASES', 'RT_USING_WDT'], CPPPATH = CPPPATH)

Return('group')
