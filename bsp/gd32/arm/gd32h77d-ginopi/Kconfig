mainmenu "RT-Thread Configuration"

BSP_DIR := .

RTT_DIR := ../../../..

PKGS_DIR := packages

source "$(RTT_DIR)/Kconfig"

# Board defaults must precede the package defaults.
config GD32VW553_SAMPLE_RESET_PIN
    int
    default 37 if BSP_USING_GD32VW553_AT # PC5: 2 * 16 + 5

osource "$PKGS_DIR/Kconfig"
rsource "../libraries/Kconfig"

if !RT_USING_NANO
rsource "board/Kconfig"
rsource "applications/Kconfig"
endif
