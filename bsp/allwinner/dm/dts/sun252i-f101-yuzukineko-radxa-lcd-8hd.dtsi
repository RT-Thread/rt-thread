        15 00 02 6f 10
        15 00 02 70 78
        15 00 02 71 63
        15 00 02 72 54
        15 00 02 73 49
        15 00 02 74 45
        15 00 02 75 38
        15 00 02 76 3d
        15 00 02 77 28
        15 00 02 78 43
        15 00 02 79 41
        15 00 02 7a 43
        15 00 02 7b 62
        15 00 02 7c 50
        15 00 02 7d 57
        15 00 02 7e 49
        15 00 02 7f 44
        15 00 02 80 37
        15 00 02 81 23
        15 00 02 82 10
        15 00 02 e0 02
        15 00 02 00 47
        15 00 02 01 47
        15 00 02 02 45
        15 00 02 03 45
        15 00 02 04 4b
        15 00 02 05 4b
        15 00 02 06 49
        15 00 02 07 49
        15 00 02 08 41
        15 00 02 09 1f
        15 00 02 0a 1f
        15 00 02 0b 1f
