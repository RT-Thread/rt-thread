from building import *
import os

cwd     = GetCurrentDir()
CPPPATH = [cwd]
src = ['main.c', 'mnt.c',  'mmu_demo.c']

# romfs_data.c is generated by tools/mkromfs.py.
# Fall back to the placeholder image when it is absent.
if os.path.exists(os.path.join(cwd, 'romfs_data.c')):
    src += ['romfs_data.c']
else:
    src += ['romfs.c']

group = DefineGroup('Applications', src, depend = [''], CPPPATH = CPPPATH)

Return('group')
