      <TargetDriverDllRegistry>
        <SetRegEntry>
          <Number>0</Number>
          <Key>UL2CM3</Key>
          <Name>UL2CM3(-S0 -C0 -P0 ) </Name>
        </SetRegEntry>
        <SetRegEntry>
          <Number>0</Number>
          <Key>JL2CM3</Key>
          <Name>-O111 -N00("ARM CoreSight SW-DP") -S2 -ZTIFSpeedSel5000 -A0 -C-1 -JU1 -JI127.0.0.1 -JP0 -RST0 -TO18 -TC10000000 -TP21 -TDS8007 -TDT0 -TDC1F -TIEFFFFFFFF -TIP8 -TB1 -TFE0 -FO7 -FD22000000 -FC7800 -FN3 -FF0RA8P1_1M.FLM -FS02000000 -FL0100000 -FP0($$Device:R7KA8P1KF$Flash\RA8P1_1M.FLM) -FF1RA8P1_CONF.FLM -FS102C9F040 -FL17C0 -FP1($$Device:R7KA8P1KF$Flash\RA8P1_CONF.FLM) -FF2RA8P1_OTP.FLM -FS202E07600 -FL210334 -FP2($$Device:R7KA8P1KF$Flash\RA8P1_OTP.FLM)</Name>
        </SetRegEntry>
        <SetRegEntry>
          <Number>0</Number>
          <Key>UL2V8M</Key>
          <Name>UL2V8M(-S0 -C0 -P0 ) -FN3 -FC7800 -FD22000000 -FF0RA8P1_1M -FF1RA8P1_CONF -FF2RA8P1_OTP -FL0100000 -FL17C0 -FL210334 -FS02000000 -FS102C9F040 -FS202E07600 -FP0($$Device:R7KA8P1KF$Flash\RA8P1_1M.FLM) -FP1($$Device:R7KA8P1KF$Flash\RA8P1_CONF.FLM) -FP2($$Device:R7KA8P1KF$Flash\RA8P1_OTP.FLM)</Name>
        </SetRegEntry>
      </TargetDriverDllRegistry>
