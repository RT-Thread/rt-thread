menu "cromfs Testcase"

config RT_UTEST_DFS_CROMFS
    bool "cromfs dirent name bound test"
    default n
    depends on RT_USING_DFS_V2 && RT_USING_DFS_CROMFS
    select RT_USING_DFS_TMPFS
    help
        Mount a crafted cromfs image from memory and check that a directory
        entry whose name_size does not fit into struct dirent::d_name is
        rejected instead of being copied.

endmenu
