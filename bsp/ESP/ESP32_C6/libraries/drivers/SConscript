import os
from building import *

cwd = GetCurrentDir()
src = ['board.c']

# This directory is built through a scons variant dir (duplicate=0), so the
# hand maintained sdkconfig.h that the ESP-IDF sources include is not copied
# next to the objects.  Add the real directory to the include path.
CPPPATH = [cwd, Dir('.').srcnode().abspath]

if GetDepend('BSP_USING_GPIO'):
    src += ['drv_gpio.c']

if GetDepend('BSP_USING_UART'):
    src += ['drv_uart.c']

if GetDepend('BSP_USING_ADC'):
    src += ['drv_adc.c']

if GetDepend('BSP_USING_I2C'):
    src += ['drv_hw_i2c.c']
    
if GetDepend('BSP_USING_PWM'):
    src += ['drv_pwm.c']

if GetDepend('BSP_USING_CLOCK_TIMER'):
    src += ['drv_timer.c']

if GetDepend('BSP_USING_WIFI'):
    src += ['drv_wifi.c']

if GetDepend('BSP_USING_SPI'):
    src += ['drv_spi.c']


group = DefineGroup('Drivers', src, depend = [''], CPPPATH = CPPPATH)

Return('group')
