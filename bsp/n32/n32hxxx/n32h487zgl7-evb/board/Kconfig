            config BSP_NAND_OOB_SIZE
                int "OOB (Spare Area) Size (bytes)"
                default 64
                help
                    NAND flash spare area size per page, typically 64 or 128.

            config BSP_NAND_PAGES_PER_BLOCK
                int "Pages Per Block"
                default 64
                help
                    Number of pages per erase block, typically 64 or 128.

            config BSP_NAND_BLOCK_COUNT
                int "Total Block Count"
                default 1024
                help
                    Total number of blocks in the NAND flash chip.

            config BSP_NAND_PLANE_NUM
                int "Plane Number"
                default 1
                help
