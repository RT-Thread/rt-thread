            3a 00 01 55
            11 78 00
            29 0a 00
        ];
#else
        rt-thread,defer-display-on;
        format = "r5g6b5";

        /* command, post-command delay in ms, payload size, payload */
        panel-init-sequence = [
            36 00 01 00
            3a 00 01 55
            f0 00 01 28
            f2 00 01 28
            73 00 01 f0
            7c 00 01 d1
            83 00 01 e0
            84 00 01 61
            f2 00 01 82
