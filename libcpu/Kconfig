    if ARCH_RISCV_VECTOR
        choice ARCH_VECTOR_VLEN
            prompt "RISCV Vector Vlen"
            default ARCH_VECTOR_VLEN_128

            config ARCH_VECTOR_VLEN_128
                bool "128"
            config ARCH_VECTOR_VLEN_256
                bool "256"
            config ARCH_VECTOR_VLEN_512
                bool "512"
            config ARCH_VECTOR_VLEN_1024
                bool "1024"
            config ARCH_VECTOR_VLEN_2048
                bool "2048"
            config ARCH_VECTOR_VLEN_4096
                bool "4096"
        endchoice
    endif

